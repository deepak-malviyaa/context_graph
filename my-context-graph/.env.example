# Agent Memory Context Graph Application
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# WARNING: Change all default credentials before deploying to any
# network-accessible environment. Never commit real credentials to git.

# Neo4j Connection
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j  # Aura default is always "neo4j" (not the instance ID)

# LLM API Keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_EXTRACTION_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=  # Optional: enables OpenAI embeddings (local sentence-transformers used by default)

# Application
DOMAIN_ID=agent-memory
SESSION_STRATEGY=per_conversation
BACKEND_PORT=8000
FRONTEND_PORT=3000

# CORS — comma-separated origins allowed for frontend (default: http://localhost:3000)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Suppress HuggingFace Hub warnings (set HF_TOKEN for higher rate limits)
HF_HUB_DISABLE_TELEMETRY=1
# HF_TOKEN=your-huggingface-token-here
