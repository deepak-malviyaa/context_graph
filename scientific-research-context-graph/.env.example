# Scientific Research Context Graph Application
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# WARNING: Change all default credentials before deploying to any
# network-accessible environment. Never commit real credentials to git.

# Neo4j Connection
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here

# LLM API Keys
# Primary LLM provider: Groq (required)
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b           # Any Groq tool-calling model, e.g. llama-3.3-70b-versatile
GROQ_URL=https://api.groq.com/openai/v1

# Optional providers (not required to run the agent)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=  # Optional: enables OpenAI embeddings for conversation memory (local sentence-transformers used by default)
GOOGLE_API_KEY=  # Optional: required only for google-adk framework

# Application
DOMAIN_ID=scientific-research
SESSION_STRATEGY=persistent
BACKEND_PORT=8001
FRONTEND_PORT=3001

# CORS — comma-separated origins allowed for frontend (default: http://localhost:3001)
# CORS_ORIGINS=http://localhost:3001,https://yourdomain.com

# Suppress HuggingFace Hub warnings (set HF_TOKEN for higher rate limits)
HF_HUB_DISABLE_TELEMETRY=1
# HF_TOKEN=your-huggingface-token-here
